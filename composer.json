{
    "name": "alt-design/alt-riffraff",
    "description": "Detects spam in Statamic form submissions using the RiffRaff API, holding suspected spam for review in the control panel.",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "spam",
        "spam-protection",
        "forms",
        "riffraff"
    ],
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "issues": "https://github.com/alt-design/Alt-RiffRaff-Addon/issues"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\RiffRaff\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\RiffRaff\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.74|^6.26"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "laravel/pint": "^1.22",
        "rector/rector": "^2.0",
        "pestphp/pest": "^4.7"
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "RiffRaff",
            "description": "A Statamic addon for managing RiffRaff"
        },
        "laravel": {
            "providers": [
                "AltDesign\\RiffRaff\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
